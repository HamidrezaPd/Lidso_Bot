# توکن ربات اصلی که از @BotFather گرفتی
BOT_TOKEN=

# آیدی عددی خودت (میتونی چندتا ادمین با کاما جدا کنی)
# آیدی عددی رو از بات @userinfobot بگیر
ADMIN_IDS=

# یوزرنیم ربات بدون @ - برای ساخت لینک رفرال لازمه
BOT_USERNAME=

# اگه تلگرام روی سیستمت فیلتره و از یک پروکسی/وی‌پی‌ان لوکال استفاده می‌کنی
# آدرس SOCKS5 یا HTTP پروکسی لوکالت رو اینجا بذار.
# روی سرور خارج (بدون فیلترینگ) این مقدار رو خالی بذار.
PROXY_URL=

# مسیر دیتابیس
# پیش‌فرض (SQLite - برای تست محلی):
DATABASE_URL=sqlite+aiosqlite:///lidso_database.db
# برای PostgreSQL روی سرور (به POSTGRESQL_MIGRATION.md نگاه کن):
# DATABASE_URL=postgresql+asyncpg://lidso_user:PASSWORD@localhost:5432/lidso_db

# حداقل مبلغ شارژ کیف پول (پیش‌فرض عمومی - هر روش پرداخت جدا هم از /admin قابل تنظیمه)
MIN_TOPUP_AMOUNT=10000

# تنظیمات رفرال
REFERRAL_BONUS_AMOUNT=20000
REFERRAL_NEEDED_COUNT=3

# مهلت قبل از حذف خودکار سرویس منقضی‌شده (ساعت)
RENEWAL_GRACE_HOURS=72
SCHEDULER_INTERVAL_MINUTES=30

# سطح لاگ: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# درگاه پرداخت زرین‌پال (اختیاری)
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=
